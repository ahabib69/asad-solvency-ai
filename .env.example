# =====================================================================
#  ASAD SOLVENCY — environment configuration
#  1) Copy this file to ".env" in the project root:   cp .env.example .env
#  2) Paste your keys below. NEVER commit .env or put keys in frontend code.
#  3) Restart the server (npm run dev).  Check with: npm run check
# =====================================================================

# ---- Server ----
PORT=8787
HOST=0.0.0.0
# Optional: only needed if the frontend is hosted on a different domain
CORS_ORIGIN=

# ---- OpenAI (one key powers chat, images, neural voice & speech-to-text) ----
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Conversational AI (Problem Solver, Live AI, Make Yourself Useful) ----
# Works with ANY OpenAI-compatible API. Leave LLM_API_KEY empty to reuse OPENAI_API_KEY.
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o-mini  (or gpt-4o, gpt-4.1)
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1       LLM_MODEL=anthropic/claude-3.5-sonnet
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1     LLM_MODEL=llama-3.3-70b-versatile
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1          LLM_MODEL=llama3.1   LLM_API_KEY=ollama
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Faster model for real-time voice conversation (defaults to LLM_MODEL)
LLM_LIVE_MODEL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1800

# ---- Creative Studio (image generation) ----
# IMAGE_PROVIDER=openai     -> uses OPENAI_API_KEY + OPENAI_IMAGE_MODEL (gpt-image-1 supports reference photos + face preservation)
# IMAGE_PROVIDER=stability  -> uses STABILITY_API_KEY (Stable Image Core/Ultra, native aspect ratios)
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_BASE_URL=https://api.openai.com/v1

# Stability AI (optional) — also enables the "Upscale to 4K" button. https://platform.stability.ai/account/keys
STABILITY_API_KEY=
STABILITY_MODEL=core

# ---- Live AI voice ----
# Neural TTS voice (alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
OPENAI_STT_MODEL=whisper-1

# ---- Misc ----
RATE_LIMIT_PER_MIN=60
# DATA_DIR=./server/data
