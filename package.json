{
  "name": "asad-solvency-ai",
  "version": "1.0.0",
  "description": "ASAD SOLVENCY \u2014 Every Problem Has A Way Forward. AI problem solver, Live AI companion, Creative Studio and productivity coach.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "check": "node scripts/check-env.js",
    "setup": "node scripts/setup.js",
    "go": "node scripts/setup.js && npm run dev",
    "build:start": "npm run build && npm start"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.27.0",
    "remark-gfm": "^4.0.0",
    "vite": "^5.4.10"
  }
}