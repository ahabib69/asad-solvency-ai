{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/index.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/generated/(.*)", "destination": "/api" },
    { "source": "/((?!api/|generated/|assets/|robots\\.txt|sitemap\\.xml|favicon\\.svg).*)", "destination": "/index.html" }
  ]
}